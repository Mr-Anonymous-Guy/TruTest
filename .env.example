# TrustTest Environment Variables
# ================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -------------------------------------------------------------------
# ASI:One API (OpenAI-compatible)
# Base URL: https://api.asi1.ai/v1
# Model:    asi1
# -------------------------------------------------------------------
ASI_ONE_API_KEY=YOUR_ASI_ONE_API_KEY_HERE
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1

# -------------------------------------------------------------------
# Agent Seeds (Used to derive deterministic Bech32 agent addresses)
# Generate a random seed per agent, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------------------
ORCHESTRATOR_SEED=REPLACE_WITH_ORCHESTRATOR_SEED
PARSER_SEED=REPLACE_WITH_PARSER_SEED
DATA_SEED=REPLACE_WITH_DATA_SEED
BACKTEST_SEED=REPLACE_WITH_BACKTEST_SEED
SKEPTIC_SEED=REPLACE_WITH_SKEPTIC_SEED

# -------------------------------------------------------------------
# Agent Addresses (Auto-derived from seeds via python scripts/print_addresses.py)
# -------------------------------------------------------------------
ORCHESTRATOR_AGENT_ADDRESS=agent1q...
PARSER_AGENT_ADDRESS=agent1q...
DATA_AGENT_ADDRESS=agent1q...
BACKTEST_AGENT_ADDRESS=agent1q...
SKEPTIC_AGENT_ADDRESS=agent1q...

# -------------------------------------------------------------------
# Phase 4 Fault Injection (For testing & video demonstrations only)
# Supported values: data_live_fail, data_fail, backtest_fail,
#                   skeptic_timeout, llm_fail, llm_badjson
# -------------------------------------------------------------------
# TRUSTTEST_FAULT=data_live_fail

# -------------------------------------------------------------------
# Phase 5 Interactive Cards Feature Flag
# Values: on (default, enables ASI:One cards), off (pure text fallback)
# -------------------------------------------------------------------
TRUSTTEST_CARDS=on
TRUSTTEST_CARD_TTL=1800
