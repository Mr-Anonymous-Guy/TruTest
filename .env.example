# TrustTest Environment Variables
# ================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -------------------------------------------------------------------
# ASI:One API (OpenAI-compatible)
# Base URL: https://api.asi1.ai/v1
# Model:    asi1
# -------------------------------------------------------------------
ASI1_API_KEY=YOUR_ASI1_API_KEY_HERE

# -------------------------------------------------------------------
# Agent seeds (used to derive deterministic agent addresses)
# Generate a random seed per agent, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------------------
ORCHESTRATOR_SEED=REPLACE_WITH_RANDOM_SEED
PARSER_SEED=REPLACE_WITH_RANDOM_SEED
DATA_SEED=REPLACE_WITH_RANDOM_SEED
BACKTEST_SEED=REPLACE_WITH_RANDOM_SEED
SKEPTIC_SEED=REPLACE_WITH_RANDOM_SEED

# -------------------------------------------------------------------
# Agent addresses (filled in after first run / Agentverse registration)
# -------------------------------------------------------------------
ORCHESTRATOR_ADDRESS=agent1q...
PARSER_ADDRESS=agent1q...
DATA_ADDRESS=agent1q...
BACKTEST_ADDRESS=agent1q...
SKEPTIC_ADDRESS=agent1q...
